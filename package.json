{
  "name": "@usefae/bellhop-node",
  "version": "1.0.0",
  "description": "Print to the label printers and read the USB scales at a physical location, from your Node application.",
  "license": "MIT",
  "author": "Fae Software",
  "homepage": "https://bellhop.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usefae/bellhop-node.git"
  },
  "bugs": {
    "url": "https://github.com/usefae/bellhop-node/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "API.md"
  ],
  "bin": {
    "bellhop": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/adapters/express.d.ts",
        "default": "./dist/adapters/express.js"
      },
      "require": {
        "types": "./dist/adapters/express.d.cts",
        "default": "./dist/adapters/express.cjs"
      }
    },
    "./fastify": {
      "import": {
        "types": "./dist/adapters/fastify.d.ts",
        "default": "./dist/adapters/fastify.js"
      },
      "require": {
        "types": "./dist/adapters/fastify.d.cts",
        "default": "./dist/adapters/fastify.cjs"
      }
    },
    "./web": {
      "import": {
        "types": "./dist/adapters/web.d.ts",
        "default": "./dist/adapters/web.js"
      },
      "require": {
        "types": "./dist/adapters/web.d.cts",
        "default": "./dist/adapters/web.cjs"
      }
    },
    "./ws": {
      "import": {
        "types": "./dist/ws.d.ts",
        "default": "./dist/ws.js"
      },
      "require": {
        "types": "./dist/ws.d.cts",
        "default": "./dist/ws.cjs"
      }
    },
    "./sqlite": {
      "import": {
        "types": "./dist/store/sqlite.d.ts",
        "default": "./dist/store/sqlite.js"
      },
      "require": {
        "types": "./dist/store/sqlite.d.cts",
        "default": "./dist/store/sqlite.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "require": {
        "types": "./dist/testing/index.d.cts",
        "default": "./dist/testing/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:dist": "node --test test-dist/smoke.test.mjs",
    "check:package": "publint && attw --pack . --profile node16",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && npm run test:dist"
  },
  "peerDependencies": {
    "express": ">=4",
    "fastify": ">=4",
    "ws": ">=8"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "@vitest/coverage-v8": "^2.1.9",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "express": "^5.2.1",
    "fastify": "^5.2.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^2.1.8",
    "ws": "^8.21.3"
  },
  "keywords": [
    "bellhop",
    "printing",
    "label-printer",
    "zpl",
    "zebra",
    "scale",
    "shipping"
  ],
  "sideEffects": false
}
